{
    "$schema": "https://opencode.ai/config.json",
    "plugins": [
        "./integrations/opencode-longmemory"
    ],
    "mcp": {
        "servers": {
            "longmemory": {
                "type": "local",
                "command": [
                    "longmemory",
                    "mcp",
                    "--project",
                    "current"
                ],
                "codemode": false
            }
        }
    }
}
